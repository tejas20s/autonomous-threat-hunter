# ── Database ────────────────────────────────────────────────────────
# PostgreSQL (recommended for production)
DATABASE_URL=postgresql+asyncpg://soc_user:soc_password@localhost:5432/insider_threat
# SQLite (for local development, no setup needed)
# DATABASE_URL=sqlite+aiosqlite:///data/threat.db

# ── Authentication ──────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production

# ── Email Notifications ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_EMAIL_FROM=soc@company.com
NOTIFICATION_EMAIL_TO=analyst@company.com

# ── Slack Notifications ─────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/here

# ── Threat Intelligence ─────────────────────────────────────────────
VIRUSTOTAL_API_KEY=your-virustotal-api-key
ABUSEIPDB_API_KEY=your-abuseipdb-api-key

# ── Model Training ──────────────────────────────────────────────────
RETRAIN_INTERVAL_HOURS=24
ISOLATION_FOREST_CONTAMINATION=0.06
BASELINE_TRAIN_DAYS=30
BASELINE_MIN_DAYS=10

# ── Application ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=*
